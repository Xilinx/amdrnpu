# build.sh creates everything below at the top of this subtree --
# Python venv, west workspace, the Xilinx zephyr-amd clone, the
# Zephyr SDK + the arm-zephyr-eabi toolchain, west-managed lopper /
# modules / bootloader / tools, the lopper-emitted system DT under
# output_dir/, the per-build CMake/Ninja tree under zephyr/build/,
# the .zip deployment package, and stray Xilinx/Vitis state under
# .Xil/. None of these are source-of-truth: any one of them can be
# regenerated by re-running ./build.sh, and accidentally checking
# even one in would explode the amdrnpu repo by hundreds of MB.
.venv/
.west/
.Xil/
# Anchored to this subtree's top level so the west workspace dir is
# ignored, but a nested module dir named zephyr/ (e.g.
# src/driver/zephyr/module.yml) stays tracked.
/zephyr/
zephyr.upstream/
zephyr-sdk-*/
modules/
bootloader/
tools/
lopper/
output_dir/
output_log.txt
build/
build_pkg_*/
*.tar.xz
*.zip

# build.sh step 11 stages the XSA into the working directory if
# CWD differs from the source location -- harmless when the source
# copy IS the working dir (our default) but the dup shows up after
# someone runs build.sh from a sibling worktree. Same idea for any
# Vitis-generated BIF/BOOT noise that lands at the top level.
*.bif
example_design_pfm_fixed.xsa.tmp
