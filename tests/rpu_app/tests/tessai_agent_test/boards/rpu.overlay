/*
 * Link A acceptance overlay.
 *
 * The stock upstream R52 board sets chosen.zephyr,sram to
 * /memory@00000000 (NoC DDR @ 0x00100000), which is fine for JTAG/XSDB
 * boot but is rejected by Linux remoteproc when rproc1 tries to load
 * the ELF: the kernel-side carveout ddrboot@0a000100 (1 MiB, injected
 * by apply_tessai_patch.py) doesn't cover 0x00100000. Re-pointing
 * zephyr,sram at &apu_rpmsg_fw (reserved.dtsi Section D) links
 * RPURuntime's loadable text/data into the carveout Linux already
 * reserves for rproc1. .resource_table stays at apu_rsctbl (0x0a000000),
 * matching kernel-DT rsc_tbl_carveout_1.
 *
 * The compatible re-narrow on &apu_rpmsg_fw drops the
 * zephyr,memory-region binding so making it the main SRAM doesn't
 * also emit a duplicate MEMORY block / burn an extra MPU slot.
 *
 * Boundary contract (do not break in isolation):
 *   apu_rpmsg_fw.reg      == ddrboot@a000100 kernel carveout
 *                            (reg = <0x00 0x0a000100 0x00 0xfff00>)
 *   apu_rsctbl.reg        == rsc_tbl_carveout_1
 *   apu_rpmsg_shmem.reg   == rpu1vdev0vring0/1 + rpu1vdev0buffer cluster
 */

&apu_rpmsg_fw {
	compatible = "mmio-sram";
	/delete-property/ zephyr,memory-region;
	/delete-property/ zephyr,memory-attr;
};

/ {
	chosen {
		zephyr,sram = &apu_rpmsg_fw;
	};
};
