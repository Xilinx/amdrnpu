config AMDRNPU
	bool
	default y

# ---------------------------------------------------------------------------
# Link A — APU (amdrnpu driver) <-> RPURuntime slave-side rpmsg.
#
# When enabled, apu_rpmsg_platform.c + amdrnpu_endpoint.c are
# compiled and the standard CONFIG_OPENAMP_RSC_TABLE machinery is
# pulled in so the kernel remoteproc framework can find the published
# resource table at apu_rsctbl in the loaded ELF.
# ---------------------------------------------------------------------------

config AMDRNPU_APU_RPMSG_SLAVE
	bool "Enable link A (APU<->RPURuntime) OpenAMP slave transport"
	default n
	select OPENAMP
	select MBOX
	select OPENAMP_RSC_TABLE
	select CACHE_MANAGEMENT
	select OPENAMP_WITH_DCACHE
	help
	  Compile apu_rpmsg_platform.c so RPURuntime serves the
	  "amdrnpu" rpmsg endpoint to the APU userspace driver via
	  the link A IPI mailbox (ipi_2_to_ipi_5) and the link A
	  reserved-memory carveouts (apu_rsctbl, apu_rpmsg_shmem). Set
	  this for any RPURuntime test that needs to be reachable from
	  the amdrnpu kernel driver.

# Force a non-zero vring buffer count whenever link A is enabled.
# The VDEV_ID / VRING0_ID / VRING1_ID macros and the
# rsc_table_to_vdev / rsc_table_get_vring{0,1} helpers in
# zephyr/lib/open-amp/resource_table.h are all gated by
# `#if CONFIG_OPENAMP_RSC_TABLE_NUM_RPMSG_BUFF > 0`, so without this
# default apu_rpmsg_platform.c fails to compile (undeclared VDEV_ID,
# implicit-decl rsc_table_get_vring0/1). 8 matches the rpu-fw
# slave-side openamp_platform.c pin in rpu-fw/rpu_fw/prj.conf.
config OPENAMP_RSC_TABLE_NUM_RPMSG_BUFF
	default 8 if AMDRNPU_APU_RPMSG_SLAVE

config AMDRNPU_VERBOSE
	bool "amdrnpu driver debug output"
	default n
	help
	  Enable verbose debug printk output from the amdrnpu driver
	  (AMDRNPU_DBG macro in apu_rpmsg_platform.c). When disabled
	  (default), only error messages (AMDRNPU_ERR) are printed.
